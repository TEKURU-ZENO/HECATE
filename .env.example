# =============================================================================
# HECATE — Environment Configuration
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to source control.
# =============================================================================

# --- Platform ---
HECATE_ENV=development
HECATE_VERSION=0.1.0
HECATE_LOG_LEVEL=INFO
HECATE_DEBUG=false

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hecate
POSTGRES_USER=hecate
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://hecate:changeme@localhost:5432/hecate
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=changeme
REDIS_URL=redis://:changeme@localhost:6379/0
REDIS_DB=0
REDIS_CACHE_TTL=300

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_METRICS=metrics-topic
KAFKA_TOPIC_ANOMALY=anomaly-topic
KAFKA_TOPIC_RCA=rca-topic
KAFKA_TOPIC_DECISION=decision-topic
KAFKA_TOPIC_REMEDIATION=remediation-topic
KAFKA_TOPIC_REPORTING=reporting-topic
KAFKA_GROUP_ID_DETECTION=detection-agent-group
KAFKA_GROUP_ID_RCA=rca-agent-group
KAFKA_GROUP_ID_DECISION=decision-agent-group
KAFKA_GROUP_ID_REMEDIATION=remediation-agent-group
KAFKA_GROUP_ID_LEARNING=learning-agent-group
KAFKA_GROUP_ID_REPORTING=reporting-agent-group
KAFKA_AUTO_OFFSET_RESET=latest
KAFKA_ENABLE_AUTO_COMMIT=false
KAFKA_MAX_POLL_RECORDS=500

# --- Prometheus ---
PROMETHEUS_URL=http://localhost:9090
PROMETHEUS_SCRAPE_INTERVAL=15
PROMETHEUS_EVALUATION_INTERVAL=15

# --- Kubernetes ---
KUBECONFIG=~/.kube/config
HECATE_NAMESPACE=hecate-system
K8S_IN_CLUSTER=false
K8S_API_TIMEOUT=30
REMEDIATION_DRY_RUN=true

# --- Auth ---
JWT_SECRET_KEY=changeme-use-strong-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60
JWT_REFRESH_EXPIRY_DAYS=7

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme
GRAFANA_URL=http://localhost:3000

# --- OpenTelemetry ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=hecate
OTEL_TRACES_SAMPLER=always_on
OTEL_LOG_LEVEL=info

# --- Jaeger ---
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6831
JAEGER_UI_URL=http://localhost:16686

# --- Elasticsearch ---
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX_INCIDENTS=hecate-incidents
ELASTICSEARCH_INDEX_AUDIT=hecate-audit-log
ELASTICSEARCH_INDEX_REPORTS=hecate-reports
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=changeme

# --- Dashboard API ---
DASHBOARD_API_HOST=0.0.0.0
DASHBOARD_API_PORT=8000
DASHBOARD_API_RELOAD=true
DASHBOARD_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Detection Agent ---
ANOMALY_SCORE_THRESHOLD=0.75
RULE_EVAL_WINDOW_SECONDS=60
ML_MODEL_PATH=./models/isolation_forest.pkl
ENABLE_ML_DETECTION=false
CPU_THRESHOLD_PERCENT=85.0
MEMORY_THRESHOLD_PERCENT=90.0
ERROR_RATE_THRESHOLD=0.05
LATENCY_P99_THRESHOLD_MS=2000

# --- Decision Agent ---
RISK_LEVEL_AUTO_REMEDIATE=LOW,MEDIUM
RISK_LEVEL_REQUIRE_APPROVAL=HIGH,CRITICAL
MAX_CONCURRENT_REMEDIATIONS=3
DECISION_COOLDOWN_SECONDS=300

# --- Learning Agent ---
RETRAINING_TRIGGER_SAMPLES=1000
FEEDBACK_WINDOW_HOURS=24
MLFLOW_TRACKING_URI=http://localhost:5001
MODEL_REGISTRY_URI=http://localhost:5001

# --- AWS (Production) ---
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=
EKS_CLUSTER_NAME=hecate-prod
ECR_REGISTRY=
S3_BUCKET_ARTIFACTS=hecate-ml-artifacts

# --- HashiCorp Vault (Production) ---
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=
VAULT_MOUNT_PATH=hecate

# --- Notifications ---
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#hecate-incidents
PAGERDUTY_ROUTING_KEY=
PAGERDUTY_SEVERITY_MAP=CRITICAL:critical,HIGH:error,MEDIUM:warning,LOW:info

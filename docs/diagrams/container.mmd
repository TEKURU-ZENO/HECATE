C4Container
  title Container Diagram for HECATE
  System_Boundary(hecate_boundary, "HECATE System") {
    Container(fe, "Dashboard Frontend", "React, TypeScript, Vite", "Visualizes real-time status, topology, and Twin explorer")
    Container(api, "Dashboard API / Gateway", "FastAPI", "REST API & WebSockets for frontend")
    ContainerDb(postgres, "PostgreSQL", "Relational", "Incident data, approvals, policy rules, Q-values")
    ContainerDb(redis, "Redis", "Key-Value", "Session states, cache, locking")
    ContainerDb(kafka, "Apache Kafka / SQLite", "Message Log", "Broker for inter-agent events (10 topics)")
    ContainerDb(timescale, "TimescaleDB", "Time-series", "Stores metric history")
    
    Container(agent_m, "Monitoring Agent", "Python", "Pulls Prometheus metrics and sends to metrics-topic")
    Container(agent_d, "Detection Agent", "Python", "Evaluates anomalies via IF/LSTM and sends to anomaly-topic")
    Container(agent_r, "RCA Agent", "Python", "Traverses dependency graph, traces root cause, and sends to rca-topic")
    Container(agent_rec, "Recommendation Agent", "Python", "Computes similarity matches, updates TD Q-values, and sends to recommendation-topic")
    Container(agent_sim, "Simulation Agent", "Python", "Simulates sequences via twin and sends to simulation-topic")
    Container(agent_dec, "Decision Agent", "Python", "Checks Execution Validator, evaluates OPA policies, risk score, and sends to decision-topic")
    Container(agent_rem, "Remediation Agent", "Python", "Runs self-healing playbooks on K8s API")
    Container(agent_learn, "Learning Agent", "Python", "Computes effectiveness, logs to operational memory, sends to learning-topic")
    Container(agent_rep, "Reporting Agent", "Python", "Summarizes incident details")

    Container(twin_svc, "Digital Twin Service", "Python/FastAPI", "Models virtual multi-cloud topologies, sequence simulations, cost/MTTR scoring, and self-calibration")
    Container(policy_svc, "Policy Service", "Python/FastAPI", "Evaluates OPA-like YAML declarative constraints")
    Container(graph_svc, "Graph Service", "Python/FastAPI", "Tracks runtime knowledge graph relationships (Neo4j / In-Memory Mock)")
    Container(copilot_svc, "Copilot Service", "Python/FastAPI", "Interactive chat interface, QA reasoning, and Planning Engine")
  }
  Rel(fe, api, "Queries", "JSON/WebSockets")
  Rel(api, postgres, "Reads/Writes")
  Rel(api, copilot_svc, "Interacts with Chat", "HTTP")
  Rel(copilot_svc, graph_svc, "Queries topology / RCA", "HTTP")
  
  Rel(agent_m, kafka, "Publishes raw metrics", "metrics-topic")
  Rel(kafka, agent_d, "Consumes raw metrics", "metrics-topic")
  Rel(agent_d, kafka, "Publishes anomalies", "anomaly-topic")
  Rel(kafka, agent_r, "Consumes anomalies", "rca-topic")
  Rel(agent_r, graph_svc, "Syncs incidents & queries RCA", "HTTP")
  Rel(agent_r, kafka, "Publishes diagnosed root cause", "rca-topic")
  Rel(kafka, agent_rec, "Consumes RCA", "rca-topic")
  Rel(agent_rec, graph_svc, "Syncs recommendations", "HTTP")
  Rel(agent_rec, kafka, "Publishes recommendations", "recommendation-topic")
  Rel(kafka, agent_sim, "Consumes recommendations", "recommendation-topic")
  Rel(agent_sim, twin_svc, "Queries sequence simulation", "HTTP")
  Rel(agent_sim, kafka, "Publishes simulation results", "simulation-topic")
  Rel(kafka, agent_dec, "Consumes simulation results", "simulation-topic")
  Rel(agent_dec, policy_svc, "Evaluates constraints", "HTTP")
  Rel(agent_dec, twin_svc, "Validates target liveness", "HTTP")
  Rel(agent_dec, graph_svc, "Syncs approvals", "HTTP")
  Rel(agent_dec, kafka, "Publishes remediation decisions", "decision-topic")
  Rel(kafka, agent_rem, "Consumes decisions", "decision-topic")
  Rel(agent_rem, graph_svc, "Syncs playbook executions", "HTTP")
  Rel(kafka, agent_learn, "Consumes feedback", "learning-topic")
  Rel(agent_learn, postgres, "Writes to operational_memory", "SQL")